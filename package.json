{
  "name": "tripways-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "deno test --config supabase/functions/deno.json --allow-read supabase/functions",
    "test:ingestion": "deno test --config supabase/functions/deno.json --allow-read supabase/functions/_shared/security/tests/ingestion_sql_contract.test.ts supabase/functions/v1/ingestion/base-data/tests supabase/functions/v1/ingestion/price-estimates/tests",
    "test:pseo:contract": "deno test --config supabase/functions/deno.json --allow-read supabase/functions/_shared/security/tests/canonical_pseo_sql_contract.test.ts",
    "edge:check": "deno check --config supabase/functions/deno.json supabase/functions/v1/system/health/index.ts supabase/functions/v1/location-suggest/index.ts supabase/functions/v1/page/query/index.ts supabase/functions/v1/route-search/query/index.ts supabase/functions/v1/sitemap/query/index.ts supabase/functions/v1/ingestion/base-data/index.ts supabase/functions/v1/flight/affiliate-handoff/index.ts supabase/functions/v1/flight/airport-routes-cache/index.ts supabase/functions/v1/flight/route-cache/index.ts supabase/functions/v1/ingestion/routes/index.ts",
    "edge:fmt:check": "deno fmt --config supabase/functions/deno.json --check supabase/functions",
    "verify": "pnpm format:check && pnpm edge:fmt:check && pnpm edge:check",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local --yes",
    "supabase:migrations:regenerate": "bash scripts/regenerate-supabase-migrations.sh",
    "smoke:approved-api": "deno run --allow-env --allow-net scripts/smoke-approved-base-data-api.ts",
    "check:staging": "bash scripts/check-staging-readiness.sh",
    "ourairports:generate-local": "deno run --allow-net=davidmegginson.github.io,raw.githubusercontent.com --allow-read=supabase/seed/ourairports --allow-write=supabase/seed/ourairports scripts/generate-ourairports-local-data.ts",
    "ourairports:import-local": "deno run --allow-env=LOCAL_DATABASE_URL --allow-read=supabase/seed/ourairports --allow-run=psql scripts/import-ourairports-local-data.ts",
    "routes:import-sample": "deno run --allow-net --allow-env --allow-read --allow-run=psql scripts/import-sample-direct-routes.ts",
    "airlines:import-travelpayouts": "deno run --allow-net --allow-env --allow-read --allow-run=psql scripts/import-travelpayouts-airlines.ts",
    "content:generate": "deno run --allow-read --allow-write content/generate_content_migration.ts",
    "content:apply": "deno run --allow-read --allow-write --allow-env --allow-run content/generate_content_migration.ts --apply",
    "verify:p0a": "bash scripts/verify-p0a-local.sh"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
