{
  "name": "tripways-backend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:auth:contract": "deno test --config supabase/functions/deno.json --allow-read supabase/functions/_shared/security/tests/user_auth_sql_contract.test.ts",
    "test:auth": "pnpm test:auth:contract && deno test --config supabase/functions/deno.json supabase/functions/_shared/tests supabase/functions/v1/user/profile/tests supabase/functions/v1/user/account-security/tests supabase/functions/v1/user/delete-account/tests",
    "test:ingestion": "deno test --config supabase/functions/deno.json --allow-read supabase/functions/_shared/security/tests/ingestion_sql_contract.test.ts supabase/functions/v1/ingestion/base-data/tests",
    "edge:check": "deno check --config supabase/functions/deno.json supabase/functions/v1/system/health/index.ts supabase/functions/v1/user/profile/index.ts supabase/functions/v1/user/account-security/index.ts supabase/functions/v1/user/delete-account/index.ts supabase/functions/v1/city-page/query/index.ts supabase/functions/v1/airport-page/query/index.ts supabase/functions/v1/ingestion/base-data/index.ts",
    "edge:fmt:check": "deno fmt --config supabase/functions/deno.json --check supabase/functions",
    "verify": "pnpm format:check && pnpm edge:fmt:check && pnpm edge:check",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset --local --yes",
    "supabase:migrations:regenerate": "bash scripts/regenerate-supabase-migrations.sh",
    "smoke:approved-api": "deno run --allow-env --allow-net scripts/smoke-approved-base-data-api.ts",
    "verify:p0a": "bash scripts/verify-p0a-local.sh"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
